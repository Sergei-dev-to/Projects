{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lr-positivity.invalid/schemas/p1-gate-policy-v1.schema.json",
  "title": "Integrator-pinned P1 gate policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "baseline", "e1", "tools", "fixtures"],
  "properties": {
    "schema_version": {"const": "lr-p1-gate-policy/v1"},
    "gate_id": {"const": "P1"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triples_payload_sha256", "count", "scope", "canonicalization_token"],
      "properties": {
        "triples_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 1},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_length", "max_size"],
          "properties": {
            "max_length": {"type": "integer", "minimum": 1},
            "max_size": {"type": "integer", "minimum": 0}
          }
        },
        "canonicalization_token": {"type": "string", "minLength": 1}
      }
    },
    "e1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "gate", "evaluator_name", "canonicalizer_version", "allowed_interpolation_modes", "zero_comparison_fields", "required_anchors"],
      "properties": {
        "schema_version": {"const": 1},
        "gate": {"const": "P1_E1_BASELINE_PARITY"},
        "evaluator_name": {"const": "lrcalc-interp"},
        "canonicalizer_version": {"const": "swap-only-v1"},
        "allowed_interpolation_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["adaptive", "conservative"]}
        },
        "zero_comparison_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_anchors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "lrcalc", "pynormaliz", "normaliz"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "lrcalc": {"type": "string", "minLength": 1},
        "pynormaliz": {"type": "string", "minLength": 1},
        "normaliz": {"type": "string", "minLength": 1}
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_count", "definition_file_sha256", "evaluator_names", "required_coverage"],
      "properties": {
        "min_count": {"type": "integer", "minimum": 1},
        "definition_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluator_names": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["lrcalc-interp", "normaliz-ehrhart"]}
        },
        "required_coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
