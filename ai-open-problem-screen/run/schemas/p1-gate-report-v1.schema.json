{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lr-positivity.invalid/schemas/p1-gate-report-v1.schema.json",
  "title": "P1 fail-closed gate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "passed", "checked_at_utc", "policy_sha256", "evidence_manifest_sha256", "checks", "failures", "next_action"],
  "properties": {
    "schema_version": {"const": "lr-p1-gate-report/v1"},
    "gate_id": {"const": "P1"},
    "passed": {"type": "boolean"},
    "checked_at_utc": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "next_action": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "detail": {"type": "string"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      }
    }
  }
}
