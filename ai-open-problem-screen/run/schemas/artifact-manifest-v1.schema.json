{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lr-positivity.invalid/schemas/artifact-manifest-v1.schema.json",
  "title": "LR campaign artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_utc", "scope", "producer", "artifacts"],
  "properties": {
    "schema_version": {"const": "lr-artifact-manifest/v1"},
    "manifest_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_utc": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "writer_id", "tool", "tool_version"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "writer_id": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "role", "media_type", "size_bytes", "sha256"],
      "properties": {
        "logical_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "role": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
